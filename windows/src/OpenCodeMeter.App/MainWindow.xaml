<Window x:Class="OpenCodeMeter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenCodeMeter.App.Controls"
        Title="OpenCode Meter"
        Width="136" Height="136"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        Closing="OnClosing"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave"
        PreviewMouseLeftButtonDown="OnMouseLeftButtonDown"
        PreviewMouseMove="OnMouseMove"
        PreviewMouseLeftButtonUp="OnMouseLeftButtonUp"
        MouseRightButtonUp="OnMouseRightButtonUp"
        LostMouseCapture="OnLostMouseCapture">

    <Grid x:Name="Root" Background="{x:Null}">

        <!-- ================= floating ball ================= -->
        <Grid x:Name="BallView"
              Width="136" Height="136"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Cursor="SizeAll">
            <Ellipse Width="128" Height="128"
                     Fill="{StaticResource BallBackground}"
                     Stroke="{StaticResource PanelStroke}"
                     StrokeThickness="1">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270"
                                      Color="#FF000000" Opacity="0.5" />
                </Ellipse.Effect>
            </Ellipse>

            <controls:RingGauge Width="136" Height="136" Radius="56" Thickness="5"
                                GapAngle="84" IsHitTestVisible="False"
                                Progress="{Binding MonthlyProgress}"
                                ProgressBrush="{Binding MonthlyBrush}"
                                TrackBrush="{StaticResource TrackBrush}" />
            <controls:RingGauge Width="136" Height="136" Radius="49" Thickness="5"
                                GapAngle="84" IsHitTestVisible="False"
                                Progress="{Binding WeeklyProgress}"
                                ProgressBrush="{Binding WeeklyBrush}"
                                TrackBrush="{StaticResource TrackBrush}" />
            <controls:RingGauge Width="136" Height="136" Radius="42" Thickness="5"
                                GapAngle="84" IsHitTestVisible="False"
                                Progress="{Binding RollingProgress}"
                                ProgressBrush="{Binding RollingBrush}"
                                TrackBrush="{StaticResource TrackBrush}" />

            <!-- centre: status + last successful refresh -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,-6,0,0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" Margin="4,0,0,0"
                               FontSize="8.5" FontWeight="Medium"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
                <TextBlock Text="{Binding UpdatedTimeText}" Margin="0,1,0,0"
                           HorizontalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="{Binding UpdatedCaption}" Margin="0,-1,0,0"
                           HorizontalAlignment="Center"
                           FontSize="7"
                           Foreground="{StaticResource TextTertiary}" />
            </StackPanel>

            <!-- countdowns inside the bottom notch -->
            <Canvas Width="136" Height="136" IsHitTestVisible="False">
                <TextBlock Text="{Binding RollingGapText}"
                           Canvas.Left="8" Canvas.Top="94" Width="120"
                           TextAlignment="Center" FontSize="7.5" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock Text="{Binding WeeklyGapText}"
                           Canvas.Left="8" Canvas.Top="104" Width="120"
                           TextAlignment="Center" FontSize="7.5" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock Text="{Binding MonthlyGapText}"
                           Canvas.Left="8" Canvas.Top="114" Width="120"
                           TextAlignment="Center" FontSize="7.5" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}" />
            </Canvas>
        </Grid>

        <!-- ================= hover: expanded card ================= -->
        <Border x:Name="WidgetView"
                Width="440" Height="192"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="26"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelStroke}"
                BorderThickness="1"
                Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                  Color="#FF000000" Opacity="0.55" />
            </Border.Effect>

            <Grid Margin="22,16,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="OpenCode" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Go 订阅额度" FontSize="9.5" Margin="8,0,0,2"
                                   VerticalAlignment="Bottom"
                                   Foreground="{StaticResource TextTertiary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Margin="5,0,0,0"
                                   FontSize="9.5" Foreground="{Binding StatusBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,7,0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="5 小时" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding RollingPercentText}"
                                   VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{Binding RollingBrush}" />
                        <controls:HorizontalBar Grid.Column="2" Height="6" Margin="4,0,12,0"
                                                VerticalAlignment="Center"
                                                Progress="{Binding RollingProgress}"
                                                FillBrush="{Binding RollingBrush}"
                                                TrackBrush="{StaticResource TrackBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding RollingResetText}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontSize="10.5" Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextTertiary}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="周限额" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding WeeklyPercentText}"
                                   VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{Binding WeeklyBrush}" />
                        <controls:HorizontalBar Grid.Column="2" Height="6" Margin="4,0,12,0"
                                                VerticalAlignment="Center"
                                                Progress="{Binding WeeklyProgress}"
                                                FillBrush="{Binding WeeklyBrush}"
                                                TrackBrush="{StaticResource TrackBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding WeeklyResetText}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontSize="10.5" Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextTertiary}" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="月限额" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding MonthlyPercentText}"
                                   VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{Binding MonthlyBrush}" />
                        <controls:HorizontalBar Grid.Column="2" Height="6" Margin="4,0,12,0"
                                                VerticalAlignment="Center"
                                                Progress="{Binding MonthlyProgress}"
                                                FillBrush="{Binding MonthlyBrush}"
                                                TrackBrush="{StaticResource TrackBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding MonthlyResetText}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontSize="10.5" Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextTertiary}" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <TextBlock Text="{Binding UpdatedText}" FontSize="8.5"
                               Foreground="{StaticResource TextTertiary}" />
                    <TextBlock Text="{Binding RefreshCaption}" FontSize="8.5"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource TextTertiary}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ================= edge-docked strip ================= -->
        <Border x:Name="StripView"
                Width="80" Height="300"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="26"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelStroke}"
                BorderThickness="1"
                Opacity="0" IsHitTestVisible="False"
                Cursor="SizeAll"
                ToolTip="{Binding TooltipText}"
                ToolTipService.InitialShowDelay="250"
                ToolTipService.ShowDuration="30000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                  Color="#FF000000" Opacity="0.55" />
            </Border.Effect>

            <Grid Margin="10,12,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBlock Text="OpenCode" FontSize="8.5" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimary}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,2,0,0">
                        <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Margin="3,0,0,0"
                                   FontSize="7.5" Foreground="{Binding StatusBrush}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,8,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding RollingPercentText}"
                                   HorizontalAlignment="Center" FontSize="8"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{Binding RollingBrush}" />
                        <controls:VerticalBar Grid.Row="1" Width="10" Margin="0,4"
                                              HorizontalAlignment="Center"
                                              Progress="{Binding RollingProgress}"
                                              FillBrush="{Binding RollingBrush}"
                                              TrackBrush="{StaticResource TrackBrush}"
                                              CornerRadius="5" />
                        <TextBlock Grid.Row="2" Text="5h" HorizontalAlignment="Center"
                                   FontSize="8" Foreground="{StaticResource TextTertiary}" />
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding WeeklyPercentText}"
                                   HorizontalAlignment="Center" FontSize="8"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{Binding WeeklyBrush}" />
                        <controls:VerticalBar Grid.Row="1" Width="10" Margin="0,4"
                                              HorizontalAlignment="Center"
                                              Progress="{Binding WeeklyProgress}"
                                              FillBrush="{Binding WeeklyBrush}"
                                              TrackBrush="{StaticResource TrackBrush}"
                                              CornerRadius="5" />
                        <TextBlock Grid.Row="2" Text="1w" HorizontalAlignment="Center"
                                   FontSize="8" Foreground="{StaticResource TextTertiary}" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding MonthlyPercentText}"
                                   HorizontalAlignment="Center" FontSize="8"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{Binding MonthlyBrush}" />
                        <controls:VerticalBar Grid.Row="1" Width="10" Margin="0,4"
                                              HorizontalAlignment="Center"
                                              Progress="{Binding MonthlyProgress}"
                                              FillBrush="{Binding MonthlyBrush}"
                                              TrackBrush="{StaticResource TrackBrush}"
                                              CornerRadius="5" />
                        <TextBlock Grid.Row="2" Text="1m" HorizontalAlignment="Center"
                                   FontSize="8" Foreground="{StaticResource TextTertiary}" />
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="2" Text="{Binding UpdatedTimeText}"
                           HorizontalAlignment="Center" FontSize="7.5"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{StaticResource TextTertiary}" />
            </Grid>
        </Border>
    </Grid>
</Window>
